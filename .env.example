# Copy this file to .env and change the values.

# Port the server listens on
PORT=3000

# Long random string used to sign login cookies. CHANGE THIS before going live.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Only allow sign-ups with this email domain (BRACU student emails).
# Leave empty to allow any email address (handy while testing).
ALLOWED_EMAIL_DOMAIN=g.bracu.ac.bd

# Comma-separated emails that get admin rights (can delete any upload or comment).
ADMIN_EMAILS=

# Maximum upload size in megabytes
MAX_UPLOAD_MB=50

# Folder for the database and uploaded files (leave empty to use this project folder).
# On Render, add a persistent disk mounted at /var/data and set STORAGE_DIR=/var/data
STORAGE_DIR=

# Set to "production" when deployed behind HTTPS (makes cookies Secure)
NODE_ENV=development
